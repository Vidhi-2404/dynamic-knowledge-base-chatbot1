# ==============================================================================
# Dynamic Knowledge Base Chatbot - Environment Configuration
# ==============================================================================

# --- AI & Answer Generation ---
# Google Gemini API Key for answer generation. If not provided, the chatbot runs in
# clearly labeled Demo/Extractive synthesis mode without crashing.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# --- Administration Security ---
# Secret passphrase required to perform write actions (ingest, re-index, purge)
# in the Knowledge Base Admin panel.
ADMIN_SECRET=change-me-to-a-secure-admin-passphrase

# --- Vector Database Configuration ---
# Storage adapter type: "local" (default) or "http" (for hosted ChromaDB server / cloud)
CHROMA_ADAPTER_TYPE=local

# Local persistence directory (used when CHROMA_ADAPTER_TYPE=local)
CHROMA_PERSIST_DIR=./data/chroma_db

# Collection name in vector database
CHROMA_COLLECTION_NAME=dynamic_kb

# Hosted ChromaDB settings (used when CHROMA_ADAPTER_TYPE=http)
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_SSL=false
CHROMA_AUTH_TOKEN=

# --- Embedding Provider ---
# Options: "sentence-transformers" (recommended, local/offline, maintained)
#          "chroma-default" (built-in chromadb onnx model)
#          "gemini" (Google text-embedding-004, requires GEMINI_API_KEY)
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# --- Document Processing & Chunking ---
CHUNK_SIZE=600
CHUNK_OVERLAP=120

# --- Web & URL Security (SSRF Protection) ---
MAX_FETCH_SIZE_MB=5
FETCH_TIMEOUT_SECONDS=10
ALLOWED_URL_SCHEMES=http,https

# --- Retrieval Configuration ---
TOP_K_RETRIEVAL=4
MIN_SIMILARITY_SCORE=0.1
